{
  "name": "pluck-remotion",
  "version": "1.0.0",
  "description": "공기업 연봉 딥다이브 — Remotion 영상/썸네일 렌더러",
  "scripts": {
    "postinstall": "node copy-fonts.mjs",
    "copy-fonts": "node copy-fonts.mjs",
    "dev": "remotion studio",
    "render": "remotion render DeepDive out/video.mp4 --props=./public/props.json",
    "thumbnail": "remotion still Thumbnail out/thumbnail.png --props=./public/props.json",
    "thumbnail-b": "remotion still ThumbnailB out/thumbnail_b.png --props=./public/props.json"
  },
  "dependencies": {
    "@remotion/cli": "4.0.470",
    "@remotion/fonts": "4.0.470",
    "pretendard": "1.3.9",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.470"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "typescript": "5.5.4"
  }
}
